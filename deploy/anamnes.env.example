# Copy to server: /etc/anamnes.env (chmod 600)
# Do not commit real secrets to git.
#
# Production (Django): set DJANGO_* below, then:
#   sudo bash /opt/anamnes/deploy/switch-to-django-only.sh
#   sudo bash /opt/anamnes/deploy/check-production.sh

# --- Django (required on production) ---
DJANGO_DEBUG=0
# openssl rand -base64 48
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=anamnes.ikorsakov.tech
# Behind nginx HTTPS (default on when DEBUG=0):
# DJANGO_SECURE_SSL_REDIRECT=1
# Optional HSTS after HTTPS verified: DJANGO_HSTS_SECONDS=31536000

ANAMNES_ADMIN_PASSWORD=change-me-strong-password
ANAMNES_DATA_DIR=/opt/anamnes/data
ANAMNES_DOCTORS_FILE=/opt/anamnes/data/doctors.json

# Optional: PostgreSQL for doctors + submissions (see deploy/postgres.env.example)
# ANAMNES_DATABASE_URL=postgresql://anamnes:PASSWORD@127.0.0.1:5432/anamnes

ANAMNES_PUBLIC_URL=https://anamnes.ikorsakov.tech

# Patient Telegram bot (link to web form)
ANAMNES_TELEGRAM_PATIENT_BOT_TOKEN=

# Patient bot username (for links and QR)
ANAMNES_TELEGRAM_BOT_USERNAME=ikorsakov_anamnes_bot

# Notify doctor on new submission (Streamlit). If ANAMNES_TELEGRAM_BOT_TOKEN is empty,
# the patient bot token above is used for sendMessage.
ANAMNES_TELEGRAM_BOT_TOKEN=
ANAMNES_TELEGRAM_CHAT_ID=

# Optional SMTP (Gmail App Password, Yandex, etc.)
# Required for email notifications. Without these, only Telegram works (if configured).
ANAMNES_SMTP_HOST=smtp.gmail.com
ANAMNES_SMTP_PORT=587
ANAMNES_SMTP_USER=your@gmail.com
ANAMNES_SMTP_PASSWORD=app-password-here
ANAMNES_SMTP_FROM=your@gmail.com
# Admin copy (BCC) and fallback if doctor email is empty:
ANAMNES_SMTP_TO=admin@example.com
# Attach raw JSON to email (default off — TXT summary + patient files instead):
# ANAMNES_EMAIL_ATTACH_JSON=0
