# /etc/nginx/sites-available/anamnes-django

server {
    listen 80;
    server_name anamnes.ikorsakov.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name anamnes.ikorsakov.tech;

    # ssl_certificate /etc/letsencrypt/live/anamnes.ikorsakov.tech/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/anamnes.ikorsakov.tech/privkey.pem;

    client_max_body_size 30M;

    location /media/ {
        alias /opt/anamnes/media/;
    }

    location /static/ {
        alias /opt/anamnes/staticfiles/;
    }

    location ~ ^/d/([a-z0-9_-]+)/?$ {
        return 302 $scheme://$host/?doctor=$1;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120;
    }
}
