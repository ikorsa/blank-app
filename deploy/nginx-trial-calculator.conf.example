# Пример: калькулятор выборки КИ на порту 8080
# Скопировать: sudo cp deploy/nginx-trial-calculator.conf.example /etc/nginx/sites-available/trial-calculator
# sudo ln -sf /etc/nginx/sites-available/trial-calculator /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx

server {
    listen 8080;
    server_name ikorsakov.tech;

    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
