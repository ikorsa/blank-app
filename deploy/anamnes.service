[Unit]
Description=Anamnes endocrinology Streamlit app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anamnes
Group=anamnes
WorkingDirectory=/opt/anamnes
EnvironmentFile=/etc/anamnes.env
ExecStart=/opt/anamnes/.venv/bin/streamlit run streamlit_app.py --server.address=127.0.0.1 --server.port=9090 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
